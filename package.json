{
  "name": "car-system-server",
  "version": "1.0.0",
  "description": "Aurora Motors API — Node.js backend for the existing car-system React frontend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/database/seed/index.ts",
    "db:setup": "prisma migrate deploy && tsx src/database/seed/index.ts",
    "openapi": "tsx src/app/export-openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/database/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.901.0",
    "@aws-sdk/client-ses": "^3.901.0",
    "@aws-sdk/client-ssm": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
