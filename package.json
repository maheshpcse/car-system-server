{
  "name": "car-system-server",
  "version": "1.0.0",
  "description": "Aurora Motors API — Node.js backend for the existing car-system React frontend.",
  "type": "module",
  "engines": {
    "node": "18.13.0",
    "npm": ">=8.19.2"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "start:prod": "node dist/scripts/start-production.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/database/seed/index.ts",
    "db:generate-data-migration": "tsx src/database/seed/generate-data-migration.ts",
    "db:setup": "prisma migrate deploy && tsx src/database/seed/index.ts",
    "openapi": "tsx src/app/export-openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/database/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.699.0",
    "@aws-sdk/client-secrets-manager": "3.699.0",
    "@aws-sdk/client-ses": "3.699.0",
    "@aws-sdk/client-ssm": "3.699.0",
    "@aws-sdk/s3-request-presigner": "3.699.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "5.22.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "18.19.68",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.6",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "prettier": "3.3.3",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.4.5",
    "vitest": "2.1.9"
  }
}
